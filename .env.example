# Postgres connection string (Supabase: Project Settings > Database > Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email sign-in links via Resend (resend.com)
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Timesheets <timesheets@yourdomain.com>"
# Company name shown on PDFs and headers
COMPANY_NAME="Your Company LLC"
# Local development only. NEVER set in production: lets anyone sign in as any user.
DEV_LOGIN=
